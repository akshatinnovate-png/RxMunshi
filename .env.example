# Everything is optional: with nothing set, RxMunshi runs in Demo mode with synthetic data.

# Supabase (live mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only: WhatsApp webhook writes

# Gemini (bill + prescription OCR, Munshi agent)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Meta WhatsApp Cloud API (otherwise wa.me links are used)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=                # verifies webhook signatures
WHATSAPP_VERIFY_TOKEN=              # webhook subscription handshake
WHATSAPP_REFILL_TEMPLATE=refill_reminder_v1
